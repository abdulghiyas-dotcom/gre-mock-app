# Production data layer (Prisma / Postgres). Not needed for the seed-file dev mode.
DATABASE_URL="postgresql://user:password@localhost:5432/gre_mock?schema=public"

# Optional: enables real AWA essay scoring via Claude. Without this set, the
# essay scorer falls back to a transparent heuristic (word count, paragraph
# structure, connective usage) so the flow still works end-to-end.
# ANTHROPIC_API_KEY="sk-ant-..."

# The question bank is bundled from src/data/*.json at build time (synced
# from content-gen/seed/ via `node content-gen/sync-to-app.mjs`), so no
# runtime filesystem access or SEED_DIR is needed in production.
