# Production data layer (Prisma / Postgres). Not needed for the seed-file dev mode.
DATABASE_URL="postgresql://user:password@localhost:5432/gre_mock?schema=public"

# Optional: override where the app/seed loader reads the question bank from.
# Defaults to ../../content-gen/seed relative to the app's working directory.
# SEED_DIR="/absolute/path/to/content-gen/seed"
